---
import { CardGrid } from '@astrojs/starlight/components';
import { loadRecentlyAddedRepoData } from '../utils/reposDataManipulator';

const repositories = await loadRecentlyAddedRepoData();
---

<CardGrid>
	{repositories.map((repository) => (
		<article class="recent-repo">
			<h3><a href={repository.url}>{repository.full_name}</a></h3>
			{repository.description && <p>{repository.description}</p>}
		</article>
	))}
</CardGrid>

<style>
	.recent-repo {
		min-width: 0;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-black);
		overflow-wrap: anywhere;
	}

	.recent-repo h3 {
		margin: 0;
		font-size: var(--sl-text-lg);
	}

	.recent-repo p {
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
	}
</style>
